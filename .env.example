# 同屏 TongPing 个人版 配置模板
# 用法：把这个文件复制一份，改名为 .env（和 package.json 放在同一层），按需修改。
# 规则：一行一个 KEY=VALUE；# 开头是注释；改完必须重启 npm run up 才生效。
# 命令行里临时设置的同名变量优先于 .env。

# ---------- 基础（大多数人只需要看这一段） ----------

# 用电脑上已经装好的 Chrome（推荐）。用 Edge 就写 msedge。
# 删掉这一行则使用 `npx playwright install chromium` 下载的 Chromium。
TONGPING_CHANNEL=chrome

# 数据目录：登录态、cookie、令牌、聊天记录都在这里。不要放进代码仓库，不要发给别人。
# 默认是用户目录下的 .tongping
# TONGPING_HOME=~/.tongping

# 端口。被占用时改成别的，比如 46921。
# TONGPING_PORT=45921

# 浏览器界面语言与时区（可选）
TONGPING_LOCALE=zh-CN
TONGPING_TIMEZONE=Asia/Shanghai

# 1 = 不显示浏览器窗口（服务器 / 无桌面环境用）。桌面电脑请保持默认：无窗口模式下「陪看」录制和人工接管登录未经验证。
# TONGPING_HEADLESS=1

# ---------- 接入 claude.ai / ChatGPT 网页版（需要公网 HTTPS 隧道） ----------
# 只在本机用 Claude Code / Codex 的话，这一段全部不用填。

# 隧道给你的 https 地址，只写到域名为止，不要加 /mcp，结尾不要斜杠。
# TONGPING_PUBLIC_ORIGIN=https://xxxx-xxxx.trycloudflare.com

# 授权密码：Claude / ChatGPT 第一次连接时会弹出网页让你输入它。
# 公网可访问，请用 12 位以上的随机字符串，不要和其他网站密码相同。
# TONGPING_OAUTH_PASSWORD=

# 一般不用填：启动器会自动把 TONGPING_PUBLIC_ORIGIN 的域名加入白名单。
# 只有用了多个域名时才手动写（逗号分隔，要包含 localhost,127.0.0.1,[::1]）。
# TONGPING_ALLOWED_HOSTS=
# TONGPING_ALLOWED_ORIGINS=

# ---------- 可选功能 ----------

# 卡片里「按住说话」的语音转文字（SiliconFlow SenseVoice）。不填则该按钮不可用。
# 也可以把 key 放在 <TONGPING_HOME>/daemon/siliconflow.key 文件里。
# TONGPING_SILICONFLOW_KEY=

# 本地字幕（npm run asr:install 安装后自动启用，下面都是可选项）
# 国内网络下载模型用镜像（npm run asr:install -- --cn 会自动写这一行）
# HF_ENDPOINT=https://hf-mirror.com
# auto（有 N 卡用 GPU）| cuda | cpu
# TONGPING_ASR_DEVICE=auto
# GPU 用的模型 / CPU 用的模型
# TONGPING_ASR_MODEL=large-v3-turbo
# TONGPING_ASR_CPU_MODEL=small
# 字幕服务安装位置，默认 TONGPING_HOME/asr
# TONGPING_ASR_DIR=

# ---------- 高级（不懂就别动） ----------
# TONGPING_HOST=127.0.0.1          # 只监听本机。不要改成 0.0.0.0 暴露到局域网/公网。
# TONGPING_EXECUTABLE_PATH=        # 自定义浏览器可执行文件路径，优先级高于 TONGPING_CHANNEL
# TONGPING_WORKER_NAME=            # worker 名称，默认是电脑名
